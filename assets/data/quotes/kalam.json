{
  "creator_id": "kalam",
  "creator_name": "APJ Abdul Kalam",
  "category": "public_figure",
  "quotes": [
    {"id": "kalam_001", "text": "Dream is not that which you see while sleeping. It is something that does not let you sleep.", "tags": ["iconic", "motivational", "deep"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Speeches", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+speech"}},
    {"id": "kalam_002", "text": "If you want to shine like a sun, first burn like a sun.", "tags": ["iconic", "motivational", "deep"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Quotes", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+quotes"}},
    {"id": "kalam_003", "text": "Excellence is a continuous process and not an accident.", "tags": ["motivational", "life-advice", "deep"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Speech", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+excellence"}},
    {"id": "kalam_004", "text": "You cannot change your future. But you can change your habits. And surely your habits will change your future.", "tags": ["deep", "motivational", "life-advice"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Quotes", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+habits"}},
    {"id": "kalam_005", "text": "Small aim is a crime. Have great aim.", "tags": ["iconic", "motivational", "short"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Speech", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+aim"}},
    {"id": "kalam_006", "text": "Look at the sky. We are not alone. The whole universe is friendly to us and conspires only to give the best to those who dream and work.", "tags": ["deep", "philosophical", "motivational"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Quotes", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+universe"}},
    {"id": "kalam_007", "text": "Man needs difficulties in life because they are necessary to enjoy success.", "tags": ["deep", "motivational", "life-advice"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Speech", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+difficulties"}},
    {"id": "kalam_008", "text": "All of us do not have equal talent. But all of us have an equal opportunity to develop our talents.", "tags": ["motivational", "deep", "equality"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Speech", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+talent"}},
    {"id": "kalam_009", "text": "Failure will never overtake me if my determination to succeed is strong enough.", "tags": ["motivational", "resilience", "iconic"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Quotes", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+failure"}},
    {"id": "kalam_010", "text": "Be active! Take on responsibility! Work for the things you believe in. If you do not, you are surrendering your fate to others.", "tags": ["motivational", "life-advice", "deep"], "language": "en", "source": {"video_title": "Wings of Fire", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+Wings+of+Fire"}},
    {"id": "kalam_011", "text": "Where there is righteousness in the heart, there is beauty in the character. When there is beauty in the character, there is harmony in the home.", "tags": ["deep", "philosophical", "wisdom"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Speech", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+righteousness"}},
    {"id": "kalam_012", "text": "One best book is equal to a hundred good friends, but one good friend is equal to a library.", "tags": ["deep", "wisdom", "friendship"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Quotes", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+books"}},
    {"id": "kalam_013", "text": "Thinking is the capital. Enterprise is the way. Hard work is the solution.", "tags": ["motivational", "iconic", "short"], "language": "en", "source": {"video_title": "Ignited Minds", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+thinking"}},
    {"id": "kalam_014", "text": "If four things are followed — having a great aim, acquiring knowledge, hard work, and perseverance — then anything can be achieved.", "tags": ["motivational", "life-advice", "deep"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Speech", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+four+things"}},
    {"id": "kalam_015", "text": "My message, especially to young people, is to have courage to think differently, courage to invent, courage to travel the unexplored path.", "tags": ["motivational", "youth", "deep", "iconic"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Student Speech", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+young+people"}},
    {"id": "kalam_016", "text": "Let us sacrifice our today so that our children can have a better tomorrow.", "tags": ["deep", "wisdom", "emotional"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Quotes", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+tomorrow"}},
    {"id": "kalam_017", "text": "You have to dream before your dreams can come true.", "tags": ["motivational", "iconic", "short"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Quotes", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+dream"}},
    {"id": "kalam_018", "text": "When learning is purposeful, creativity blossoms. When creativity blossoms, thinking emanates. When thinking emanates, knowledge is fully lit.", "tags": ["deep", "wisdom", "education"], "language": "en", "source": {"video_title": "Indomitable Spirit", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+learning"}},
    {"id": "kalam_019", "text": "Don't take rest after your first victory because if you fail in the second, more lips are waiting to say that your first victory was just luck.", "tags": ["motivational", "deep", "life-advice"], "language": "en", "source": {"video_title": "APJ Abdul Kalam Quotes", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+victory"}},
    {"id": "kalam_020", "text": "Teaching is a very noble profession that shapes the character, calibre, and future of an individual. If people remember me as a good teacher, that will be the biggest honour for me.", "tags": ["heartfelt", "iconic", "wisdom", "emotional"], "language": "en", "source": {"video_title": "APJ Abdul Kalam on Teaching", "youtube_url": "https://www.youtube.com/results?search_query=APJ+Abdul+Kalam+teacher"}}
  ]
}
