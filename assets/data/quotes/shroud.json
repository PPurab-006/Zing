{
  "creator_id": "shroud",
  "creator_name": "Shroud",
  "category": "streamer",
  "quotes": [
    {"id": "shroud_001", "text": "I don't play games to win. I play to get better.", "tags": ["deep", "gaming", "motivational", "life-advice"], "language": "en", "source": {"video_title": "Shroud Stream", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_002", "text": "Consistency beats talent. Always.", "tags": ["motivational", "deep", "short", "life-advice"], "language": "en", "source": {"video_title": "Shroud Interview", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_003", "text": "I'm not special. I just played more hours than most people are willing to.", "tags": ["honest", "motivational", "deep", "relatable"], "language": "en", "source": {"video_title": "Shroud Interview", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_004", "text": "CLIP IT!", "tags": ["iconic", "funny", "catchphrase", "gaming"], "language": "en", "source": {"video_title": "Shroud Stream Moments", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_005", "text": "The pro scene taught me discipline. Streaming taught me to be human again.", "tags": ["deep", "honest", "life-advice", "emotional"], "language": "en", "source": {"video_title": "Shroud Interview", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_006", "text": "Mechanics can be learned. Game sense has to be felt.", "tags": ["deep", "gaming", "wisdom"], "language": "en", "source": {"video_title": "Shroud Stream", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_007", "text": "I left CS:GO at my peak. Some people thought I was done. I was just starting.", "tags": ["deep", "honest", "motivational", "iconic"], "language": "en", "source": {"video_title": "Shroud Interview", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_008", "text": "The mouse doesn't aim. The brain does.", "tags": ["deep", "gaming", "wisdom", "iconic"], "language": "en", "source": {"video_title": "Shroud Stream", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_009", "text": "I genuinely enjoy playing games. That sounds obvious. It's not for everyone in this industry.", "tags": ["honest", "deep", "relatable", "life-advice"], "language": "en", "source": {"video_title": "Shroud Interview", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_010", "text": "When you're calm, you aim better. In games and in life.", "tags": ["deep", "wisdom", "gaming", "life-advice"], "language": "en", "source": {"video_title": "Shroud Stream", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_011", "text": "I don't think I'm the best. I think I work the hardest to look like the best.", "tags": ["honest", "motivational", "deep", "hustle"], "language": "en", "source": {"video_title": "Shroud Interview", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_012", "text": "Streaming is better than pro play for me. I can just enjoy the game.", "tags": ["honest", "deep", "relatable", "life-advice"], "language": "en", "source": {"video_title": "Shroud Interview", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_013", "text": "Clean.", "tags": ["iconic", "funny", "catchphrase", "gaming"], "language": "en", "source": {"video_title": "Shroud Stream", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_014", "text": "People want tips. The tip is just play more.", "tags": ["funny", "honest", "deep", "gaming"], "language": "en", "source": {"video_title": "Shroud Stream", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_015", "text": "I've never cared about being famous. I care about being good.", "tags": ["deep", "honest", "identity", "motivational"], "language": "en", "source": {"video_title": "Shroud Interview", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_016", "text": "Every game has a skill ceiling. I like finding it.", "tags": ["deep", "gaming", "wisdom", "motivation"], "language": "en", "source": {"video_title": "Shroud Stream", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_017", "text": "Chat calling me a god is funny. I'm a guy who aims at pixels really well.", "tags": ["funny", "honest", "relatable", "self-deprecating"], "language": "en", "source": {"video_title": "Shroud Stream Moments", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_018", "text": "Losing is data. Process it and move on.", "tags": ["deep", "motivational", "gaming", "wisdom"], "language": "en", "source": {"video_title": "Shroud Interview", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_019", "text": "The best players I've seen all share one thing: they never stop learning.", "tags": ["motivational", "deep", "wisdom", "gaming"], "language": "en", "source": {"video_title": "Shroud Stream", "youtube_url": "https://www.youtube.com/@shroud"}},
    {"id": "shroud_020", "text": "Good vibes only in this stream. Life's too short for negativity.", "tags": ["wholesome", "community", "heartfelt", "life-advice"], "language": "en", "source": {"video_title": "Shroud Stream", "youtube_url": "https://www.youtube.com/@shroud"}}
  ]
}
