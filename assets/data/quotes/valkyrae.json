  "category": "streamer",
  "quotes": [
    {"id": "rae_001", "text": "I am the only Viper you know!", "tags": ["iconic", "funny", "gaming", "catchphrase"], "language": "en", "source": {"video_title": "Valkyrae Valorant Stream", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_002", "text": "I was working at GameStop dreaming of this. Never stop believing in what you want.", "tags": ["motivational", "heartfelt", "life-advice"], "language": "en", "source": {"video_title": "Valkyrae Interview", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_003", "text": "Chat, I can explain.", "tags": ["iconic", "funny", "catchphrase", "community"], "language": "en", "source": {"video_title": "Valkyrae Stream Moments", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_004", "text": "I don't care if people think I'm cringe. Being cringe means you actually care about something.", "tags": ["deep", "relatable", "honest", "life-advice"], "language": "en", "source": {"video_title": "Valkyrae Stream", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_005", "text": "You don't have to have it all figured out. I definitely didn't. I still don't.", "tags": ["relatable", "honest", "motivational", "life-advice"], "language": "en", "source": {"video_title": "Valkyrae Interview", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_006", "text": "The people who doubted me are the reason I work twice as hard.", "tags": ["motivational", "resilience", "life-advice"], "language": "en", "source": {"video_title": "Valkyrae Moments", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_007", "text": "My chat keeps me going. You guys are literally my energy.", "tags": ["heartfelt", "community", "emotional"], "language": "en", "source": {"video_title": "Valkyrae Stream", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_008", "text": "I genuinely thought I'd never make it. And then one day I did. Keep going.", "tags": ["motivational", "emotional", "resilience", "heartfelt"], "language": "en", "source": {"video_title": "Valkyrae Inspirational Moments", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_009", "text": "Being a woman in gaming is not a handicap. It's a superpower nobody expected.", "tags": ["deep", "identity", "motivational", "iconic"], "language": "en", "source": {"video_title": "Valkyrae Interview", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_010", "text": "Don't let anyone dim your light because it blinds them.", "tags": ["motivational", "deep", "life-advice"], "language": "en", "source": {"video_title": "Valkyrae Moments", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_011", "text": "I literally scream at video games for a living and somehow that became my dream job. Life is wild.", "tags": ["funny", "relatable", "heartfelt"], "language": "en", "source": {"video_title": "Valkyrae Stream", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_012", "text": "Never let anyone make you feel like your dreams are too big or too weird.", "tags": ["motivational", "life-advice", "heartfelt"], "language": "en", "source": {"video_title": "Valkyrae Inspirational", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_013", "text": "WHAT IS HAPPENING?!", "tags": ["iconic", "funny", "reaction", "gaming"], "language": "en", "source": {"video_title": "Valkyrae Gaming Moments", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_014", "text": "The grind doesn't stop just because nobody's watching. Especially because nobody's watching.", "tags": ["motivational", "hustle", "deep"], "language": "en", "source": {"video_title": "Valkyrae Stream", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_015", "text": "Content Creator of the Year. Me. The girl from Moses Lake who almost became a flight attendant.", "tags": ["heartfelt", "iconic", "motivational", "relatable"], "language": "en", "source": {"video_title": "Valkyrae Game Awards", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_016", "text": "Be the person your younger self needed.", "tags": ["deep", "motivational", "heartfelt", "life-advice"], "language": "en", "source": {"video_title": "Valkyrae Motivational", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_017", "text": "I used to hide that I was a gamer. Now I own part of a gaming org. Never hide who you are.", "tags": ["motivational", "identity", "iconic", "heartfelt"], "language": "en", "source": {"video_title": "Valkyrae 100 Thieves", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_018", "text": "My mom worked so hard for us. Everything I do, I do it for her.", "tags": ["emotional", "heartfelt", "family"], "language": "en", "source": {"video_title": "Valkyrae Stream Moments", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_019", "text": "Sometimes the leap of faith is just deciding to try one more day.", "tags": ["deep", "motivational", "resilience"], "language": "en", "source": {"video_title": "Valkyrae Inspirational", "youtube_url": "https://www.youtube.com/@Valkyrae"}},
    {"id": "rae_020", "text": "Rae diff.", "tags": ["iconic", "funny", "catchphrase", "community"], "language": "en", "source": {"video_title": "Valkyrae Stream", "youtube_url": "https://www.youtube.com/@Valkyrae"}}
  ]
