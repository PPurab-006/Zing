{
  "creator_id": "malala",
  "creator_name": "Malala Yousafzai",
  "category": "public_figure",
  "quotes": [
    {"id": "malala_001", "text": "We realize the importance of our voices only when we are silenced.", "tags": ["iconic", "deep", "powerful", "motivational"], "language": "en", "source": {"video_title": "I Am Malala", "youtube_url": "https://www.youtube.com/results?search_query=Malala+Yousafzai+speech"}},
    {"id": "malala_002", "text": "One child, one teacher, one book, one pen can change the world.", "tags": ["iconic", "motivational", "education", "powerful"], "language": "en", "source": {"video_title": "Malala Nobel Peace Prize Speech", "youtube_url": "https://www.youtube.com/watch?v=MOqIotJrFVM"}},
    {"id": "malala_003", "text": "When the whole world is silent, even one voice becomes powerful.", "tags": ["iconic", "deep", "motivational", "powerful"], "language": "en", "source": {"video_title": "Malala Speech", "youtube_url": "https://www.youtube.com/results?search_query=Malala+speech"}},
    {"id": "malala_004", "text": "I raise up my voice — not so I can shout, but so that those without a voice can be heard.", "tags": ["iconic", "deep", "powerful", "community"], "language": "en", "source": {"video_title": "Malala UN Speech", "youtube_url": "https://www.youtube.com/results?search_query=Malala+UN+speech"}},
    {"id": "malala_005", "text": "If one man can destroy everything, why can't one girl change it?", "tags": ["iconic", "powerful", "motivational", "deep"], "language": "en", "source": {"video_title": "I Am Malala", "youtube_url": "https://www.youtube.com/results?search_query=Malala+Yousafzai"}},
    {"id": "malala_006", "text": "With guns you can kill terrorists. With education you can kill terrorism.", "tags": ["iconic", "deep", "powerful", "education"], "language": "en", "source": {"video_title": "Malala Speech", "youtube_url": "https://www.youtube.com/results?search_query=Malala+education+speech"}},
    {"id": "malala_007", "text": "The extremists are afraid of books and pens. The power of education frightens them.", "tags": ["deep", "powerful", "education", "motivational"], "language": "en", "source": {"video_title": "I Am Malala", "youtube_url": "https://www.youtube.com/results?search_query=Malala+extremists+books"}},
    {"id": "malala_008", "text": "I don't want to be thought of as the girl who was shot by the Taliban, but the girl who fought for education.", "tags": ["iconic", "identity", "powerful", "emotional"], "language": "en", "source": {"video_title": "Malala Interview", "youtube_url": "https://www.youtube.com/results?search_query=Malala+girl+who+fought"}},
    {"id": "malala_009", "text": "I told myself, Malala, you have already faced death. This is your second life. Don't be afraid — if you are afraid, you can't move forward.", "tags": ["emotional", "deep", "resilience", "motivational"], "language": "en", "source": {"video_title": "I Am Malala", "youtube_url": "https://www.youtube.com/results?search_query=Malala+second+life"}},
    {"id": "malala_010", "text": "I had two options. One was to remain silent and wait to be killed. And the second was to speak up and then be killed. I chose the second one.", "tags": ["iconic", "powerful", "courage", "deep"], "language": "en", "source": {"video_title": "Malala Nobel Speech", "youtube_url": "https://www.youtube.com/watch?v=MOqIotJrFVM"}},
    {"id": "malala_011", "text": "Extremists have shown what frightens them most: a girl with a book.", "tags": ["iconic", "powerful", "short", "education"], "language": "en", "source": {"video_title": "Malala Quotes", "youtube_url": "https://www.youtube.com/results?search_query=Malala+Yousafzai+quotes"}},
    {"id": "malala_012", "text": "Education is neither Eastern nor Western. Education is education and it's the right of every human being.", "tags": ["deep", "education", "equality", "iconic"], "language": "en", "source": {"video_title": "Malala Interview", "youtube_url": "https://www.youtube.com/results?search_query=Malala+education+eastern+western"}},
    {"id": "malala_013", "text": "Some people only ask others to do something. I believe that, why should I wait for someone else? Why don't I take a step and move forward?", "tags": ["motivational", "deep", "life-advice", "powerful"], "language": "en", "source": {"video_title": "Malala UN Speech", "youtube_url": "https://www.youtube.com/results?search_query=Malala+UN+speech"}},
    {"id": "malala_014", "text": "Let us make our future now, and let us make our dreams tomorrow's reality.", "tags": ["motivational", "deep", "iconic", "youth"], "language": "en", "source": {"video_title": "Malala Speech", "youtube_url": "https://www.youtube.com/results?search_query=Malala+future+dreams"}},
    {"id": "malala_015", "text": "At night our fear is strong… but in the morning, in the light, we find our courage again.", "tags": ["deep", "emotional", "resilience", "beautiful"], "language": "en", "source": {"video_title": "I Am Malala", "youtube_url": "https://www.youtube.com/results?search_query=Malala+courage"}},
    {"id": "malala_016", "text": "We liked to be known as the clever girls. When we decorated our hands with henna, we drew calculus and chemical formulae instead of flowers.", "tags": ["iconic", "identity", "funny", "deep"], "language": "en", "source": {"video_title": "I Am Malala", "youtube_url": "https://www.youtube.com/results?search_query=Malala+clever+girls"}},
    {"id": "malala_017", "text": "I don't want revenge on the Taliban. I want education for sons and daughters of the Taliban.", "tags": ["deep", "powerful", "iconic", "wisdom"], "language": "en", "source": {"video_title": "Malala Interview", "youtube_url": "https://www.youtube.com/results?search_query=Malala+Taliban+education"}},
    {"id": "malala_018", "text": "There are two powers in the world. One is the sword and the other is the pen. There is a third power stronger than both — that of women.", "tags": ["iconic", "powerful", "deep", "women"], "language": "en", "source": {"video_title": "I Am Malala", "youtube_url": "https://www.youtube.com/results?search_query=Malala+sword+pen+women"}},
    {"id": "malala_019", "text": "Once I had asked God for one or two extra inches in height, but instead he made me as tall as the sky, so high that I could not measure myself.", "tags": ["deep", "beautiful", "emotional", "iconic"], "language": "en", "source": {"video_title": "I Am Malala", "youtube_url": "https://www.youtube.com/results?search_query=Malala+as+tall+as+the+sky"}},
    {"id": "malala_020", "text": "Books can capture injustices in a way that stays with you and makes you want to do something about them. That's why they are so powerful.", "tags": ["deep", "education", "wisdom", "books"], "language": "en", "source": {"video_title": "Malala on Books", "youtube_url": "https://www.youtube.com/results?search_query=Malala+books+powerful"}}
  ]
}
