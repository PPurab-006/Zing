  "quotes": [
    {"id": "dream_001", "text": "You can't just sit there and wait for life to come to you. You have to go get it.", "tags": ["motivational", "life-advice", "deep"], "language": "en", "source": {"video_title": "Dream Stream", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_002", "text": "Oh, come on!", "tags": ["iconic", "funny", "reaction", "gaming"], "language": "en", "source": {"video_title": "Dream Manhunt", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_003", "text": "I genuinely love my fans so much. Like I actually care about every single one of you.", "tags": ["heartfelt", "community", "emotional"], "language": "en", "source": {"video_title": "Dream Stream Moments", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_004", "text": "Minecraft is just chess but make it chaotic.", "tags": ["funny", "iconic", "gaming", "deep"], "language": "en", "source": {"video_title": "Dream Minecraft", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_005", "text": "The mask wasn't hiding me. It was freeing me.", "tags": ["deep", "identity", "iconic", "emotional"], "language": "en", "source": {"video_title": "Dream Face Reveal", "youtube_url": "https://www.youtube.com/watch?v=nQXCp94Q00I"}},
    {"id": "dream_006", "text": "LET'S GOOOOO!", "tags": ["iconic", "funny", "reaction", "catchphrase"], "language": "en", "source": {"video_title": "Dream Manhunt", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_007", "text": "I don't have to explain myself to anyone. I know who I am.", "tags": ["deep", "identity", "confidence"], "language": "en", "source": {"video_title": "Dream Stream", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_008", "text": "The Dream SMP wasn't just a Minecraft server. It was a whole world people escaped into.", "tags": ["deep", "community", "legacy"], "language": "en", "source": {"video_title": "Dream SMP", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_009", "text": "Stop running from the hunters and start being the hunter.", "tags": ["motivational", "iconic", "gaming", "life-advice"], "language": "en", "source": {"video_title": "Dream Manhunt", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_010", "text": "Growth is uncomfortable. That's how you know it's real.", "tags": ["deep", "motivational", "life-advice"], "language": "en", "source": {"video_title": "Dream Stream", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_011", "text": "I started this whole thing because I just wanted to make videos I thought were cool. That's still all it is.", "tags": ["honest", "relatable", "heartfelt"], "language": "en", "source": {"video_title": "Dream Interview", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_012", "text": "There's always another way out. You just have to find it.", "tags": ["motivational", "gaming", "life-advice"], "language": "en", "source": {"video_title": "Dream Manhunt", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_013", "text": "Nobody is born good at anything. I was terrible when I started.", "tags": ["motivational", "honest", "relatable", "life-advice"], "language": "en", "source": {"video_title": "Dream Interview", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_014", "text": "Clutch or kick.", "tags": ["iconic", "funny", "gaming", "catchphrase"], "language": "en", "source": {"video_title": "Dream Manhunt", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_015", "text": "The internet is strange. One day you're no one. Next day millions of people know your voice.", "tags": ["deep", "relatable", "honest"], "language": "en", "source": {"video_title": "Dream Stream", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_016", "text": "I care way too much about what I put out. I'd rather be late than be bad.", "tags": ["deep", "honest", "creative", "dedication"], "language": "en", "source": {"video_title": "Dream Interview", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_017", "text": "George get in the boat!", "tags": ["iconic", "funny", "community", "catchphrase"], "language": "en", "source": {"video_title": "Dream Manhunt", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_018", "text": "When everything is on the line, that's when you find out what you're actually made of.", "tags": ["deep", "motivational", "gaming", "life-advice"], "language": "en", "source": {"video_title": "Dream Manhunt", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_019", "text": "Content creation is weird because your bad days are everyone's entertainment.", "tags": ["honest", "deep", "relatable", "funny"], "language": "en", "source": {"video_title": "Dream Stream", "youtube_url": "https://www.youtube.com/@Dream"}},
    {"id": "dream_020", "text": "I never wanted to be famous. I just wanted to make something people enjoyed.", "tags": ["honest", "heartfelt", "deep"], "language": "en", "source": {"video_title": "Dream Interview", "youtube_url": "https://www.youtube.com/@Dream"}}
  ]
}
