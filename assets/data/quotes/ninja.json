{
  "creator_id": "ninja",
  "creator_name": "Ninja",
  "category": "streamer",
  "quotes": [
    {"id": "ninja_001", "text": "I'm not going to let anyone outwork me. That's the one thing I can control.", "tags": ["motivational", "competitive", "iconic", "hustle"], "language": "en", "source": {"video_title": "Ninja Interview", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_002", "text": "The only way to get better is to play against people better than you.", "tags": ["motivational", "gaming", "life-advice", "deep"], "language": "en", "source": {"video_title": "Ninja Stream", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_003", "text": "I went from a basement to performing at the Super Bowl halftime. Never cap your dreams.", "tags": ["motivational", "iconic", "inspirational", "heartfelt"], "language": "en", "source": {"video_title": "Ninja Interview", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_004", "text": "DUDE! Are you KIDDING me?!", "tags": ["iconic", "funny", "reaction", "gaming"], "language": "en", "source": {"video_title": "Ninja Gaming Moments", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_005", "text": "If you're not the best, work until you are. Simple as that.", "tags": ["motivational", "competitive", "short", "life-advice"], "language": "en", "source": {"video_title": "Ninja Quotes", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_006", "text": "Cancer showed me what actually matters. Not the wins. Not the views. The people.", "tags": ["emotional", "deep", "heartfelt", "life-advice"], "language": "en", "source": {"video_title": "Ninja Cancer Announcement", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_007", "text": "Fortnite didn't make me. I made Fortnite relevant. There's a difference.", "tags": ["iconic", "confident", "funny", "competitive"], "language": "en", "source": {"video_title": "Ninja Interview", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_008", "text": "Every single day I wake up and choose to be better than I was yesterday.", "tags": ["motivational", "deep", "life-advice", "hustle"], "language": "en", "source": {"video_title": "Ninja Motivational", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_009", "text": "I used to grind 16 hours a day with no viewers. Nobody sees those years. But they built everything.", "tags": ["honest", "motivational", "hustle", "deep"], "language": "en", "source": {"video_title": "Ninja Interview", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_010", "text": "The hate motivates me more than the love sometimes. Prove them wrong energy is real.", "tags": ["motivational", "honest", "competitive", "deep"], "language": "en", "source": {"video_title": "Ninja Stream", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_011", "text": "My wife is my anchor. Without her I would have lost myself in all of this.", "tags": ["heartfelt", "emotional", "deep", "personal"], "language": "en", "source": {"video_title": "Ninja Interview", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_012", "text": "Gaming isn't a phase. It's a career. It's an artform. It's a community.", "tags": ["deep", "gaming", "iconic", "motivational"], "language": "en", "source": {"video_title": "Ninja Speech", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_013", "text": "I've been the best in the world at this. I've been washed. Both taught me something.", "tags": ["honest", "deep", "resilience", "wisdom"], "language": "en", "source": {"video_title": "Ninja Interview", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_014", "text": "You miss 100% of the shots you don't take. In Fortnite and in life.", "tags": ["funny", "motivational", "gaming", "iconic"], "language": "en", "source": {"video_title": "Ninja Stream", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_015", "text": "When I got diagnosed, my first thought was — I still have more to do. That's how I knew I'd fight.", "tags": ["emotional", "resilience", "deep", "iconic"], "language": "en", "source": {"video_title": "Ninja Cancer Update", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_016", "text": "Being number one felt amazing. Losing it felt like the end. Neither was true.", "tags": ["deep", "honest", "wisdom", "life-advice"], "language": "en", "source": {"video_title": "Ninja Interview", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_017", "text": "I play to win. I always have. That's never going to change.", "tags": ["iconic", "competitive", "short", "confident"], "language": "en", "source": {"video_title": "Ninja Stream", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_018", "text": "Drake played Fortnite with me. That was surreal. Gaming really broke every barrier.", "tags": ["iconic", "funny", "legendary", "gaming"], "language": "en", "source": {"video_title": "Ninja Drake Stream", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_019", "text": "Never let the overnight success story fool you. Mine took eight years of nothing.", "tags": ["motivational", "honest", "hustle", "deep"], "language": "en", "source": {"video_title": "Ninja Interview", "youtube_url": "https://www.youtube.com/@Ninja"}},
    {"id": "ninja_020", "text": "Get good.", "tags": ["iconic", "funny", "short", "gaming", "catchphrase"], "language": "en", "source": {"video_title": "Ninja Stream", "youtube_url": "https://www.youtube.com/@Ninja"}}
  ]
}
