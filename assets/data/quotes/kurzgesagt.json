{
  "creator_id": "kurzgesagt",
  "creator_name": "Kurzgesagt",
  "category": "youtuber",
  "quotes": [
    {"id": "kurz_001", "text": "You are the universe experiencing itself.", "tags": ["deep", "philosophical", "iconic", "beautiful"], "language": "en", "source": {"video_title": "Kurzgesagt - Optimistic Nihilism", "youtube_url": "https://www.youtube.com/watch?v=MBRqu0YOH14"}},
    {"id": "kurz_002", "text": "The more you know, the more you realise how much you don't know.", "tags": ["deep", "wisdom", "philosophical", "education"], "language": "en", "source": {"video_title": "Kurzgesagt Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_003", "text": "Loneliness is one of the most painful human experiences. You are not alone in feeling alone.", "tags": ["deep", "emotional", "mental-health", "powerful"], "language": "en", "source": {"video_title": "Kurzgesagt - Loneliness", "youtube_url": "https://www.youtube.com/watch?v=n3Xv_g3g-mA"}},
    {"id": "kurz_004", "text": "Science is not a collection of facts. It is a method of asking questions.", "tags": ["deep", "wisdom", "education", "iconic"], "language": "en", "source": {"video_title": "Kurzgesagt Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_005", "text": "Optimistic nihilism: if the universe has no meaning, we get to make our own.", "tags": ["deep", "philosophical", "iconic", "beautiful"], "language": "en", "source": {"video_title": "Kurzgesagt - Optimistic Nihilism", "youtube_url": "https://www.youtube.com/watch?v=MBRqu0YOH14"}},
    {"id": "kurz_006", "text": "Complexity is not the enemy of understanding. Oversimplification is.", "tags": ["deep", "wisdom", "education", "philosophy"], "language": "en", "source": {"video_title": "Kurzgesagt Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_007", "text": "Your life is 1000 months long. Use them well.", "tags": ["deep", "iconic", "philosophical", "life-advice"], "language": "en", "source": {"video_title": "Kurzgesagt - 1000 Months", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_008", "text": "Stars died so you could exist. Think about that.", "tags": ["deep", "beautiful", "philosophical", "iconic"], "language": "en", "source": {"video_title": "Kurzgesagt Universe Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_009", "text": "The universe is under no obligation to make sense to you.", "tags": ["deep", "philosophical", "wisdom", "iconic"], "language": "en", "source": {"video_title": "Kurzgesagt Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_010", "text": "Being curious is the most human thing you can do.", "tags": ["deep", "wisdom", "education", "motivational"], "language": "en", "source": {"video_title": "Kurzgesagt Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_011", "text": "Every atom in your body was once part of a star. You are literally made of stardust.", "tags": ["beautiful", "deep", "philosophical", "iconic"], "language": "en", "source": {"video_title": "Kurzgesagt Universe Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_012", "text": "We are the only species we know of that is trying to understand where it came from.", "tags": ["deep", "philosophical", "beautiful", "wisdom"], "language": "en", "source": {"video_title": "Kurzgesagt Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_013", "text": "Procrastination is not laziness. It is fear of failure dressed in casual clothes.", "tags": ["deep", "relatable", "funny", "wisdom"], "language": "en", "source": {"video_title": "Kurzgesagt - Procrastination", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_014", "text": "In a universe this vast, the fact that you exist at all is remarkable.", "tags": ["beautiful", "deep", "philosophical", "motivational"], "language": "en", "source": {"video_title": "Kurzgesagt Universe Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_015", "text": "Knowledge is the only resource that grows when you share it.", "tags": ["deep", "wisdom", "education", "beautiful"], "language": "en", "source": {"video_title": "Kurzgesagt Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_016", "text": "The best time to start caring about the planet was yesterday. The second best time is now.", "tags": ["deep", "motivational", "powerful", "life-advice"], "language": "en", "source": {"video_title": "Kurzgesagt Climate Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_017", "text": "Humans are the only creatures who tell stories about the future. Use that power wisely.", "tags": ["deep", "philosophical", "wisdom", "beautiful"], "language": "en", "source": {"video_title": "Kurzgesagt Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_018", "text": "You are not stuck in traffic. You are traffic. Systems thinking changes everything.", "tags": ["deep", "funny", "wisdom", "iconic"], "language": "en", "source": {"video_title": "Kurzgesagt Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_019", "text": "Fear is a terrible reason not to do something.", "tags": ["motivational", "deep", "short", "life-advice"], "language": "en", "source": {"video_title": "Kurzgesagt Video", "youtube_url": "https://www.youtube.com/@kurzgesagt"}},
    {"id": "kurz_020", "text": "If you feel small and insignificant — you are. And that is the most liberating thing in the world.", "tags": ["deep", "philosophical", "iconic", "beautiful"], "language": "en", "source": {"video_title": "Kurzgesagt - Optimistic Nihilism", "youtube_url": "https://www.youtube.com/watch?v=MBRqu0YOH14"}}
  ]
}
