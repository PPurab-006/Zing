{
  "creator_id": "pokimane",
  "creator_name": "Pokimane",
  "category": "streamer",
  "quotes": [
    {"id": "poki_001", "text": "You are enough, even on your worst days.", "tags": ["motivational", "heartfelt", "community", "deep"], "language": "en", "source": {"video_title": "Pokimane Stream Moments", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_002", "text": "It's okay to not be okay. Just don't give up.", "tags": ["emotional", "motivational", "mental-health", "heartfelt"], "language": "en", "source": {"video_title": "Pokimane Inspirational", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_003", "text": "Being yourself is the most powerful thing you can do in a world that keeps telling you to be someone else.", "tags": ["deep", "motivational", "identity", "life-advice"], "language": "en", "source": {"video_title": "Pokimane Stream", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_004", "text": "I never expected this to be my life. And yet here I am, grateful every single day.", "tags": ["heartfelt", "emotional", "gratitude"], "language": "en", "source": {"video_title": "Pokimane Moments", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_005", "text": "Stop comparing your chapter one to someone else's chapter twenty.", "tags": ["motivational", "deep", "life-advice", "relatable"], "language": "en", "source": {"video_title": "Pokimane Inspirational", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_006", "text": "The internet can be cruel, but so can life. You learn to find the light in it.", "tags": ["deep", "resilience", "honest", "life-advice"], "language": "en", "source": {"video_title": "Pokimane Interview", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_007", "text": "Self-care isn't selfish. You can't pour from an empty cup.", "tags": ["deep", "life-advice", "mental-health", "motivational"], "language": "en", "source": {"video_title": "Pokimane Stream", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_008", "text": "There's nothing wrong with wanting more for yourself. Dream big and then dream bigger.", "tags": ["motivational", "life-advice", "deep"], "language": "en", "source": {"video_title": "Pokimane Motivational", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_009", "text": "poki diff", "tags": ["iconic", "funny", "catchphrase", "community"], "language": "en", "source": {"video_title": "Pokimane Stream", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_010", "text": "I grew up watching people online and thinking — I want to do that. If I could do it, so can you.", "tags": ["motivational", "heartfelt", "relatable", "community"], "language": "en", "source": {"video_title": "Pokimane Interview", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_011", "text": "Kindness is underrated. Be kind, especially when it's hard.", "tags": ["deep", "life-advice", "wisdom", "heartfelt"], "language": "en", "source": {"video_title": "Pokimane Stream Moments", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_012", "text": "Failure taught me more than success ever did.", "tags": ["motivational", "deep", "resilience", "life-advice"], "language": "en", "source": {"video_title": "Pokimane Inspirational", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_013", "text": "The people who genuinely care about you will stay even when it's inconvenient for them.", "tags": ["deep", "wisdom", "friendship", "life-advice"], "language": "en", "source": {"video_title": "Pokimane Stream", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_014", "text": "You don't owe anyone a perfect version of yourself. Just a real one.", "tags": ["deep", "identity", "motivational", "life-advice"], "language": "en", "source": {"video_title": "Pokimane Moments", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_015", "text": "I have bad days too. I just don't always show them. Nobody's highlight reel is their whole life.", "tags": ["honest", "relatable", "deep", "mental-health"], "language": "en", "source": {"video_title": "Pokimane Interview", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_016", "text": "The comeback is always stronger than the setback.", "tags": ["motivational", "resilience", "short", "iconic"], "language": "en", "source": {"video_title": "Pokimane Inspirational", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_017", "text": "Chat, you're actually the best. I mean it.", "tags": ["heartfelt", "community", "iconic"], "language": "en", "source": {"video_title": "Pokimane Stream", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_018", "text": "Growing up, I didn't see many people who looked like me doing this. I hope I can be that for someone else.", "tags": ["deep", "emotional", "identity", "community", "heartfelt"], "language": "en", "source": {"video_title": "Pokimane Interview", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_019", "text": "Your mental health matters more than any view count, follower count, or opinion.", "tags": ["deep", "mental-health", "life-advice", "motivational"], "language": "en", "source": {"video_title": "Pokimane Stream", "youtube_url": "https://www.youtube.com/@pokimane"}},
    {"id": "poki_020", "text": "Be the reason someone smiles today. It costs literally nothing.", "tags": ["heartfelt", "community", "short", "motivational"], "language": "en", "source": {"video_title": "Pokimane Moments", "youtube_url": "https://www.youtube.com/@pokimane"}}
  ]
}
