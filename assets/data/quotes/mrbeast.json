    {"id": "mb_005", "text": "I would stay up all night just thinking of ideas.", "tags": ["relatable", "creative", "hustle"], "language": "en", "source": {"video_title": "MrBeast Interview", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_006", "text": "After some point, it feels like you should quit, but you want it so badly, you just keep going.", "tags": ["motivational", "resilience", "deep"], "language": "en", "source": {"video_title": "MrBeast Interview", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_007", "text": "I like helping people. It makes me happy.", "tags": ["heartfelt", "philanthropy", "iconic"], "language": "en", "source": {"video_title": "MrBeast BrainyQuote", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_008", "text": "I woke up, I studied YouTube, I studied videos, I studied film-making, I went to bed and that was my life.", "tags": ["hustle", "dedication", "relatable"], "language": "en", "source": {"video_title": "MrBeast Interview", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_009", "text": "My standards for videos have gotten so high that we gave away 3 houses and I thought it was lame so we gave away another 2. I have a problem.", "tags": ["funny", "iconic", "chaos"], "language": "en", "source": {"video_title": "MrBeast Tweet", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_010", "text": "I have zero idea how to use a comma, punctuation, or spell 82% of the English language. I used to edit videos in the back of high school English class.", "tags": ["funny", "relatable", "iconic"], "language": "en", "source": {"video_title": "MrBeast Tweet", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_011", "text": "I'll use my money to help people and I promise to give away all my money before I die. Every single penny.", "tags": ["heartfelt", "philanthropy", "iconic", "deep"], "language": "en", "source": {"video_title": "MrBeast Statement", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_012", "text": "You have to have a never ending thirst for learning.", "tags": ["motivational", "life-advice"], "language": "en", "source": {"video_title": "MrBeast Quotes", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_013", "text": "I am motivated because I want to employ my friends and help them.", "tags": ["heartfelt", "community", "friendship"], "language": "en", "source": {"video_title": "MrBeast Interview", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_014", "text": "Treat every video like it's the most important video you'll ever make.", "tags": ["motivational", "creative", "hustle"], "language": "en", "source": {"video_title": "MrBeast Advice", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_015", "text": "Your probability of being a billionaire is higher if you don't make that your goal. Just focus on making something that is dope.", "tags": ["deep", "life-advice", "motivational"], "language": "en", "source": {"video_title": "MrBeast Interview", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_016", "text": "I just walked past two random guys casually debating how much money MrBeast makes and they didn't notice me.", "tags": ["funny", "iconic", "relatable"], "language": "en", "source": {"video_title": "MrBeast Tweet", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_017", "text": "Put yourself in the headspace of your viewer.", "tags": ["creative", "life-advice", "deep"], "language": "en", "source": {"video_title": "MrBeast Creator Advice", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_018", "text": "It's easier to get 10 million views on one video than 100K views on 100 videos.", "tags": ["deep", "creative", "iconic"], "language": "en", "source": {"video_title": "MrBeast Creator Advice", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_019", "text": "I just want to have fun and make people happy.", "tags": ["heartfelt", "iconic", "community"], "language": "en", "source": {"video_title": "MrBeast Interview", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_020", "text": "So many people say they want to do what I do but it's like — do you really? Because I literally gave up my entire teenage years.", "tags": ["deep", "honest", "hustle", "relatable"], "language": "en", "source": {"video_title": "MrBeast Interview", "youtube_url": "https://www.youtube.com/@MrBeast"}}
  ]
