    {"id": "mb_001", "text": "You're crazy until you're successful, then you are a genius.", "tags": ["motivational", "iconic", "life-advice"], "language": "en", "source": {"video_title": "MrBeast Quotes", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_002", "text": "It's just fun to help people.", "tags": ["heartfelt", "iconic", "philanthropy"], "language": "en", "source": {"video_title": "MrBeast Interview", "youtube_url": "https://www.youtube.com/@MrBeast"}},
    {"id": "mb_003", "text": "Input inspiration, output ideas.", "tags": ["creative", "motivational", "deep"], "language": "en", "source": {"video_title": "MrBeast Quotes", "youtube_url": "https://www.youtube.com/@MrBeast"}},
