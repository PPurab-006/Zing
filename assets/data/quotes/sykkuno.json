  "quotes": [
    {"id": "syk_001", "text": "Oh my goodness!", "tags": ["iconic", "funny", "catchphrase", "reaction"], "language": "en", "source": {"video_title": "Sykkuno Stream", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_002", "text": "I was totally going to do that on purpose.", "tags": ["iconic", "funny", "catchphrase", "relatable"], "language": "en", "source": {"video_title": "Sykkuno Gaming Moments", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_003", "text": "Ah shucks.", "tags": ["iconic", "funny", "catchphrase", "wholesome"], "language": "en", "source": {"video_title": "Sykkuno Stream", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_004", "text": "Kindness is always the right move, even in a game about killing each other.", "tags": ["deep", "wholesome", "life-advice", "funny"], "language": "en", "source": {"video_title": "Sykkuno Among Us", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_005", "text": "I used to be so scared to stream. Now I can't imagine not doing it.", "tags": ["heartfelt", "honest", "motivational", "emotional"], "language": "en", "source": {"video_title": "Sykkuno Interview", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_006", "text": "Being wholesome isn't a brand. It's just how I am. I can't help it.", "tags": ["honest", "identity", "heartfelt", "deep"], "language": "en", "source": {"video_title": "Sykkuno Interview", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_007", "text": "I genuinely get nervous every stream. The butterflies never fully go away.", "tags": ["honest", "relatable", "deep", "emotional"], "language": "en", "source": {"video_title": "Sykkuno Interview", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_008", "text": "Chat is family to me. I know how that sounds but I mean it.", "tags": ["heartfelt", "community", "emotional", "honest"], "language": "en", "source": {"video_title": "Sykkuno Stream", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_009", "text": "I never thought anyone would watch me. Turns out a lot of people just wanted something calm.", "tags": ["honest", "heartfelt", "relatable", "deep"], "language": "en", "source": {"video_title": "Sykkuno Interview", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_010", "text": "You don't have to be loud to be loved.", "tags": ["deep", "motivational", "identity", "wholesome"], "language": "en", "source": {"video_title": "Sykkuno Stream", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_011", "text": "Among Us made me realize how much I actually love people. Even when they betray me.", "tags": ["funny", "deep", "community", "heartfelt"], "language": "en", "source": {"video_title": "Sykkuno Among Us", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_012", "text": "I was an accountant before this. An accountant. Life is really something.", "tags": ["funny", "honest", "iconic", "relatable"], "language": "en", "source": {"video_title": "Sykkuno Interview", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_013", "text": "The quiet ones are often the ones feeling the most.", "tags": ["deep", "emotional", "wisdom", "identity"], "language": "en", "source": {"video_title": "Sykkuno Stream", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_014", "text": "I hope when people watch me they feel a little less alone.", "tags": ["heartfelt", "community", "emotional", "deep"], "language": "en", "source": {"video_title": "Sykkuno Stream", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_015", "text": "Nice try chat. I'm not falling for that. ...I'm totally falling for it.", "tags": ["funny", "iconic", "community", "relatable"], "language": "en", "source": {"video_title": "Sykkuno Stream Moments", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_016", "text": "Streaming gave me confidence I didn't know I had. It took years. But it's real.", "tags": ["motivational", "honest", "emotional", "deep"], "language": "en", "source": {"video_title": "Sykkuno Interview", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_017", "text": "You can be soft and still be strong.", "tags": ["deep", "motivational", "identity", "wisdom"], "language": "en", "source": {"video_title": "Sykkuno Stream", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_018", "text": "I pretend to be innocent. I am actually innocent. There is no pretending.", "tags": ["funny", "iconic", "wholesome", "relatable"], "language": "en", "source": {"video_title": "Sykkuno Stream Moments", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_019", "text": "Every single person watching deserves to feel seen.", "tags": ["heartfelt", "community", "deep", "emotional"], "language": "en", "source": {"video_title": "Sykkuno Stream", "youtube_url": "https://www.youtube.com/@Sykkuno"}},
    {"id": "syk_020", "text": "Goodnight everyone. I love you guys. I really do.", "tags": ["heartfelt", "outro", "community", "iconic"], "language": "en", "source": {"video_title": "Sykkuno Stream Outro", "youtube_url": "https://www.youtube.com/@Sykkuno"}}
  ]
}
