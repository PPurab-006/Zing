{
  "creator_id": "ludwig",
  "creator_name": "Ludwig",
  "category": "streamer",
  "quotes": [
    {"id": "lud_001", "text": "The subathon was supposed to be 24 hours. It lasted 31 days. I have no one to blame but myself and I regret nothing.", "tags": ["iconic", "funny", "legendary", "relatable"], "language": "en", "source": {"video_title": "Ludwig Subathon", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_002", "text": "Being good at games is cool. Being entertaining is cooler.", "tags": ["deep", "funny", "life-advice", "gaming"], "language": "en", "source": {"video_title": "Ludwig Stream", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_003", "text": "I don't think I'm the best at anything. I just refuse to be boring.", "tags": ["honest", "funny", "relatable", "deep"], "language": "en", "source": {"video_title": "Ludwig Interview", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_004", "text": "Chess taught me that the position is never as bad as it looks. And never as good.", "tags": ["deep", "wisdom", "gaming", "life-advice"], "language": "en", "source": {"video_title": "Ludwig Chess Stream", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_005", "text": "If you're not failing publicly, you're not trying hard enough publicly.", "tags": ["funny", "deep", "honest", "life-advice"], "language": "en", "source": {"video_title": "Ludwig Stream", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_006", "text": "The algorithm doesn't care about your feelings. Make good content.", "tags": ["honest", "funny", "creative", "life-advice"], "language": "en", "source": {"video_title": "Ludwig Creator Advice", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_007", "text": "Streaming taught me more about business than any class ever did.", "tags": ["deep", "honest", "life-advice"], "language": "en", "source": {"video_title": "Ludwig Interview", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_008", "text": "I signed a deal to leave Twitch. Chat rioted. I did it anyway. Sometimes you have to.", "tags": ["honest", "deep", "iconic", "life-advice"], "language": "en", "source": {"video_title": "Ludwig YouTube Move", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_009", "text": "Competition makes everyone better. Even if it makes you feel worse temporarily.", "tags": ["deep", "motivational", "wisdom"], "language": "en", "source": {"video_title": "Ludwig Stream", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_010", "text": "Day 23 of the subathon. I haven't seen the sun. I am becoming the stream.", "tags": ["iconic", "funny", "legendary", "relatable"], "language": "en", "source": {"video_title": "Ludwig Subathon Day 23", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_011", "text": "Your audience can tell when you're phoning it in. Respect them enough to actually try.", "tags": ["deep", "honest", "creative", "life-advice"], "language": "en", "source": {"video_title": "Ludwig Creator Advice", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_012", "text": "The best creators aren't the most talented. They're the most consistent.", "tags": ["deep", "motivational", "creative", "life-advice"], "language": "en", "source": {"video_title": "Ludwig Interview", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_013", "text": "I built a game company. Not because I knew how. Because I wanted to.", "tags": ["motivational", "honest", "deep", "hustle"], "language": "en", "source": {"video_title": "Ludwig Offbrand Games", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_014", "text": "Parasocial relationships are complicated. I try to be real so at least what you're attached to is actually me.", "tags": ["deep", "honest", "community", "thoughtful"], "language": "en", "source": {"video_title": "Ludwig Stream", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_015", "text": "Chat, I love you but you are genuinely insane and I mean that with my whole heart.", "tags": ["funny", "iconic", "community", "heartfelt"], "language": "en", "source": {"video_title": "Ludwig Stream Moments", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_016", "text": "The goal isn't to win. The goal is to not be boring while losing.", "tags": ["funny", "iconic", "gaming", "deep"], "language": "en", "source": {"video_title": "Ludwig Chess Stream", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_017", "text": "Every big creator you admire was once making videos for 12 people. Remember that.", "tags": ["motivational", "deep", "life-advice", "relatable"], "language": "en", "source": {"video_title": "Ludwig Creator Advice", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_018", "text": "I'm not the smartest, fastest, or most skilled. I just outwork people.", "tags": ["motivational", "honest", "hustle", "deep"], "language": "en", "source": {"video_title": "Ludwig Interview", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_019", "text": "Taking creative risks is the only way to grow. Playing it safe is its own kind of failure.", "tags": ["deep", "creative", "motivational", "life-advice"], "language": "en", "source": {"video_title": "Ludwig Stream", "youtube_url": "https://www.youtube.com/@ludwig"}},
    {"id": "lud_020", "text": "Lud diff.", "tags": ["iconic", "funny", "catchphrase", "community"], "language": "en", "source": {"video_title": "Ludwig Stream", "youtube_url": "https://www.youtube.com/@ludwig"}}
  ]
}
