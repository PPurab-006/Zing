  "category": "youtuber",
  "quotes": [
    {"id": "mari_001", "text": "A beleza está em ser autêntica, não perfeita.", "tags": ["deep", "motivational", "identity", "portuguese"], "language": "pt", "source": {"video_title": "Mariana Nolasco Vídeo", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_002", "text": "Beauty is in being authentic, not perfect.", "tags": ["deep", "motivational", "identity"], "language": "en", "source": {"video_title": "Mariana Nolasco Video", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_003", "text": "Your story is worth telling. Don't let anyone make you feel otherwise.", "tags": ["motivational", "deep", "identity", "heartfelt"], "language": "en", "source": {"video_title": "Mariana Nolasco Stream", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_004", "text": "I started making videos in my room with no idea what I was doing. Still don't. Still going.", "tags": ["funny", "honest", "relatable", "motivational"], "language": "en", "source": {"video_title": "Mariana Nolasco Interview", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_005", "text": "Brazil gave me fire. YouTube gave me wings.", "tags": ["heartfelt", "identity", "beautiful", "deep"], "language": "en", "source": {"video_title": "Mariana Nolasco Interview", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_006", "text": "Representation matters. When I started I didn't see anyone like me. Now I am that person for someone else.", "tags": ["deep", "emotional", "community", "identity"], "language": "en", "source": {"video_title": "Mariana Nolasco Speech", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_007", "text": "Comparison is the thief of joy. Focus on your own path.", "tags": ["deep", "life-advice", "motivational", "wisdom"], "language": "en", "source": {"video_title": "Mariana Nolasco Video", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_008", "text": "I laugh loud, I cry loud, I live loud. I was told to be quieter. I got louder.", "tags": ["motivational", "identity", "honest", "iconic"], "language": "en", "source": {"video_title": "Mariana Nolasco Stream", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_009", "text": "Your culture is not a trend. It is your power.", "tags": ["deep", "identity", "motivational", "global"], "language": "en", "source": {"video_title": "Mariana Nolasco Video", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_010", "text": "Building a community is the most beautiful thing content creation gave me.", "tags": ["heartfelt", "community", "emotional", "deep"], "language": "en", "source": {"video_title": "Mariana Nolasco Milestone", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_011", "text": "Te amo, comunidade!", "tags": ["iconic", "heartfelt", "community", "portuguese"], "language": "pt", "source": {"video_title": "Mariana Nolasco Stream", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_012", "text": "Imposter syndrome never goes away. You just get better at pushing through it.", "tags": ["honest", "deep", "relatable", "motivational"], "language": "en", "source": {"video_title": "Mariana Nolasco Interview", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_013", "text": "Create with your whole heart or don't create at all.", "tags": ["creative", "motivational", "deep", "life-advice"], "language": "en", "source": {"video_title": "Mariana Nolasco Video", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_014", "text": "My followers are not a number. They are people who chose to spend time with me. That is sacred.", "tags": ["deep", "community", "heartfelt", "wisdom"], "language": "en", "source": {"video_title": "Mariana Nolasco Speech", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_015", "text": "I don't create content. I create conversations.", "tags": ["deep", "creative", "identity", "iconic"], "language": "en", "source": {"video_title": "Mariana Nolasco Interview", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_016", "text": "Women in gaming, women in streaming, women in tech — we are here and we are not leaving.", "tags": ["powerful", "motivational", "identity", "deep"], "language": "en", "source": {"video_title": "Mariana Nolasco Speech", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_017", "text": "Authenticity is the only content strategy that lasts.", "tags": ["deep", "creative", "life-advice", "wisdom"], "language": "en", "source": {"video_title": "Mariana Nolasco Interview", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_018", "text": "Obrigada. From the bottom of my heart.", "tags": ["heartfelt", "iconic", "community", "emotional"], "language": "pt", "source": {"video_title": "Mariana Nolasco Milestone", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_019", "text": "Failure is just a plot twist. Not the ending.", "tags": ["motivational", "deep", "resilience", "life-advice"], "language": "en", "source": {"video_title": "Mariana Nolasco Video", "youtube_url": "https://www.youtube.com/@MariNolasco"}},
    {"id": "mari_020", "text": "The internet connected a girl from Brazil to the whole world. Never take that for granted.", "tags": ["heartfelt", "emotional", "deep", "global"], "language": "en", "source": {"video_title": "Mariana Nolasco Reflection", "youtube_url": "https://www.youtube.com/@MariNolasco"}}
  ]
