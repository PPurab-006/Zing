{
  "creator_id": "elrubius",
  "creator_name": "ElRubius",
  "category": "youtuber",
  "quotes": [
    {"id": "rubius_001", "text": "¡Ay, tío!", "tags": ["iconic", "funny", "catchphrase", "spanish"], "language": "es", "source": {"video_title": "ElRubius Stream", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_002", "text": "You don't need to speak the same language to laugh together.", "tags": ["deep", "community", "global", "heartfelt"], "language": "en", "source": {"video_title": "ElRubius Interview", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_003", "text": "I moved to Norway because sometimes you need silence to hear yourself think.", "tags": ["deep", "honest", "life-advice", "emotional"], "language": "en", "source": {"video_title": "ElRubius Announcement", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_004", "text": "Drawing was my therapy before I knew what therapy was.", "tags": ["deep", "creative", "honest", "emotional"], "language": "en", "source": {"video_title": "ElRubius Interview", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_005", "text": "Being shy doesn't stop you from connecting with millions of people. It just means you do it through a screen.", "tags": ["deep", "honest", "relatable", "identity"], "language": "en", "source": {"video_title": "ElRubius Interview", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_006", "text": "My community is global. Spain, Mexico, Argentina, everywhere. That blows my mind every day.", "tags": ["heartfelt", "community", "global", "emotional"], "language": "en", "source": {"video_title": "ElRubius Stream", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_007", "text": "I never wanted to be famous. I just wanted to make things I was proud of.", "tags": ["honest", "deep", "identity", "heartfelt"], "language": "en", "source": {"video_title": "ElRubius Interview", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_008", "text": "Anxiety is real. Don't let anyone tell you to just get over it.", "tags": ["deep", "mental-health", "honest", "emotional"], "language": "en", "source": {"video_title": "ElRubius Mental Health", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_009", "text": "I took a break and came back better. Resting is not giving up.", "tags": ["motivational", "deep", "life-advice", "honest"], "language": "en", "source": {"video_title": "ElRubius Return", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_010", "text": "The internet connected me to a world I never would have reached from my bedroom in Malaga.", "tags": ["heartfelt", "honest", "deep", "community"], "language": "en", "source": {"video_title": "ElRubius Interview", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_011", "text": "Making people laugh is a responsibility I take seriously.", "tags": ["deep", "honest", "creative", "community"], "language": "en", "source": {"video_title": "ElRubius Interview", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_012", "text": "I am half Spanish, half Norwegian, and 100% chaotic.", "tags": ["funny", "iconic", "identity", "relatable"], "language": "en", "source": {"video_title": "ElRubius Stream", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_013", "text": "Sometimes the bravest thing is to log off and go outside.", "tags": ["funny", "deep", "life-advice", "honest"], "language": "en", "source": {"video_title": "ElRubius Stream", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_014", "text": "I started this with zero plan. Somehow that was the right plan.", "tags": ["funny", "honest", "relatable", "deep"], "language": "en", "source": {"video_title": "ElRubius Interview", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_015", "text": "Spain gave me passion. Norway gave me peace. YouTube gave me purpose.", "tags": ["deep", "heartfelt", "identity", "beautiful"], "language": "en", "source": {"video_title": "ElRubius Interview", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_016", "text": "Never apologize for your accent. It means you speak more than one language.", "tags": ["deep", "identity", "motivational", "global"], "language": "en", "source": {"video_title": "ElRubius Stream", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_017", "text": "The fans who stuck around during my break — you're the reason I came back.", "tags": ["heartfelt", "emotional", "community", "honest"], "language": "en", "source": {"video_title": "ElRubius Return Stream", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_018", "text": "My cat doesn't care how many subscribers I have. Healthy perspective.", "tags": ["funny", "relatable", "iconic", "wholesome"], "language": "en", "source": {"video_title": "ElRubius Stream", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_019", "text": "Creativity has no language barrier. A good video is a good video anywhere.", "tags": ["deep", "creative", "global", "wisdom"], "language": "en", "source": {"video_title": "ElRubius Interview", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}},
    {"id": "rubius_020", "text": "See you in the next one. Stay weird.", "tags": ["iconic", "outro", "community", "funny"], "language": "en", "source": {"video_title": "ElRubius Outro", "youtube_url": "https://www.youtube.com/@elrubiusOMG"}}
  ]
}
