  "category": "youtuber",
  "quotes": [
    {"id": "bb_001", "text": "Bhuvan Bam here!", "tags": ["iconic", "intro", "hindi", "catchphrase"], "language": "hi", "source": {"video_title": "BB Ki Vines", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_002", "text": "Creativity has no language. But it does have a heart.", "tags": ["deep", "creative", "wisdom", "heartfelt"], "language": "en", "source": {"video_title": "BB Ki Vines Interview", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_003", "text": "I played all the characters myself because I could not afford actors. Necessity is the mother of invention.", "tags": ["funny", "honest", "iconic", "creative"], "language": "en", "source": {"video_title": "BB Ki Vines Interview", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_004", "text": "The day I stopped caring about views and started caring about people, everything changed.", "tags": ["deep", "honest", "motivational", "community"], "language": "en", "source": {"video_title": "BB Ki Vines Interview", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_005", "text": "Being the first Indian solo creator to hit 10 million — I cried. My mother cried. The whole family cried.", "tags": ["emotional", "heartfelt", "iconic", "legendary"], "language": "en", "source": {"video_title": "BB Ki Vines Milestone", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_006", "text": "Titu Mama zindabad!", "tags": ["iconic", "funny", "hindi", "community"], "language": "hi", "source": {"video_title": "BB Ki Vines", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_007", "text": "I started from a small room with bad lighting. Dreams do not need good lighting to shine.", "tags": ["motivational", "honest", "heartfelt", "deep"], "language": "en", "source": {"video_title": "BB Ki Vines Interview", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_008", "text": "Music saved me. I put every feeling I could not say into a song.", "tags": ["deep", "emotional", "creative", "heartfelt"], "language": "en", "source": {"video_title": "BB Ki Vines Music", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_009", "text": "My subscribers are my family. I do not have any other word for it.", "tags": ["heartfelt", "community", "emotional", "iconic"], "language": "en", "source": {"video_title": "BB Ki Vines Milestone", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_010", "text": "Comedy is truth with a funny face.", "tags": ["deep", "wisdom", "creative", "funny"], "language": "en", "source": {"video_title": "BB Ki Vines Interview", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_011", "text": "I lost my best friends in an accident. Making people laugh became a way of processing grief.", "tags": ["emotional", "deep", "honest", "heartfelt"], "language": "en", "source": {"video_title": "BB Ki Vines Interview", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_012", "text": "Never underestimate a creator with nothing to lose and everything to prove.", "tags": ["motivational", "deep", "iconic", "life-advice"], "language": "en", "source": {"video_title": "BB Ki Vines Interview", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_013", "text": "India ke bacche bhi bana sakte hain world class content.", "tags": ["iconic", "motivational", "hindi", "community"], "language": "hi", "source": {"video_title": "BB Ki Vines Speech", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_014", "text": "The internet gave a musician from Delhi a platform bigger than any stage.", "tags": ["heartfelt", "deep", "global", "emotional"], "language": "en", "source": {"video_title": "BB Ki Vines Interview", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_015", "text": "Laughter is the most honest form of human connection.", "tags": ["deep", "wisdom", "community", "beautiful"], "language": "en", "source": {"video_title": "BB Ki Vines Interview", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_016", "text": "Do not wait for perfect conditions. Start where you are with what you have.", "tags": ["motivational", "life-advice", "deep", "honest"], "language": "en", "source": {"video_title": "BB Ki Vines Creator Advice", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_017", "text": "I wrote Safar in one night. Sometimes your best work just pours out of you.", "tags": ["creative", "deep", "emotional", "honest"], "language": "en", "source": {"video_title": "BB Ki Vines Music", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_018", "text": "Ek din aayega jab sab theek ho jayega.", "tags": ["deep", "emotional", "hindi", "motivational"], "language": "hi", "source": {"video_title": "BB Ki Vines Video", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_019", "text": "Be so good they cannot ignore you. Then be humble about it.", "tags": ["motivational", "wisdom", "deep", "life-advice"], "language": "en", "source": {"video_title": "BB Ki Vines Interview", "youtube_url": "https://www.youtube.com/@BBKiVines"}},
    {"id": "bb_020", "text": "Every like, every comment, every subscriber — each one is a person who gave me their time. I never take that lightly.", "tags": ["heartfelt", "community", "deep", "emotional"], "language": "en", "source": {"video_title": "BB Ki Vines Milestone", "youtube_url": "https://www.youtube.com/@BBKiVines"}}
  ]
}
