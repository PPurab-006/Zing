{
  "creator_id": "mizkif",
  "creator_name": "Mizkif",
  "category": "streamer",
  "quotes": [
    {"id": "miz_001", "text": "I'm just a guy from Texas who got really lucky. But I also worked really hard. Both are true.", "tags": ["honest", "funny", "relatable", "deep"], "language": "en", "source": {"video_title": "Mizkif Interview", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_002", "text": "Streaming is literally just being yourself for hours. Turns out people like that.", "tags": ["funny", "honest", "deep", "relatable"], "language": "en", "source": {"video_title": "Mizkif Stream", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_003", "text": "OTK started as a friend group. Now it is a company. Never underestimate your friend group.", "tags": ["motivational", "community", "funny", "deep"], "language": "en", "source": {"video_title": "Mizkif OTK Interview", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_004", "text": "I failed school. I failed at jobs. I succeeded at talking to strangers on the internet. Find your thing.", "tags": ["funny", "honest", "motivational", "relatable"], "language": "en", "source": {"video_title": "Mizkif Interview", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_005", "text": "WHAT?!", "tags": ["iconic", "funny", "reaction", "catchphrase"], "language": "en", "source": {"video_title": "Mizkif Stream Moments", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_006", "text": "The best content is when things go wrong. Embrace the chaos.", "tags": ["funny", "honest", "creative", "life-advice"], "language": "en", "source": {"video_title": "Mizkif Stream", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_007", "text": "Chat is smarter than me. I know this. They know this. We have an understanding.", "tags": ["funny", "iconic", "community", "self-deprecating"], "language": "en", "source": {"video_title": "Mizkif Stream", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_008", "text": "Taking accountability is not weakness. It is the only way forward.", "tags": ["deep", "honest", "life-advice", "wisdom"], "language": "en", "source": {"video_title": "Mizkif Interview", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_009", "text": "Twitch is the weirdest job in the world. I would not trade it for anything.", "tags": ["funny", "heartfelt", "honest", "relatable"], "language": "en", "source": {"video_title": "Mizkif Stream", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_010", "text": "Being honest about your flaws builds more trust than pretending you have none.", "tags": ["deep", "wisdom", "honest", "life-advice"], "language": "en", "source": {"video_title": "Mizkif Interview", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_011", "text": "I care too much. That has been both my biggest strength and my biggest problem.", "tags": ["honest", "deep", "emotional", "relatable"], "language": "en", "source": {"video_title": "Mizkif Interview", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_012", "text": "Austin is built different. I do not make the rules.", "tags": ["funny", "iconic", "relatable", "community"], "language": "en", "source": {"video_title": "Mizkif Stream", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_013", "text": "Community is everything in this space. You build one real community and nothing can stop you.", "tags": ["deep", "community", "motivational", "wisdom"], "language": "en", "source": {"video_title": "Mizkif Interview", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_014", "text": "Growing up poor made me never take any of this for granted.", "tags": ["honest", "deep", "heartfelt", "emotional"], "language": "en", "source": {"video_title": "Mizkif Interview", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_015", "text": "Sometimes I cannot believe people watch me. And then I remember I am very entertaining.", "tags": ["funny", "self-deprecating", "iconic", "confident"], "language": "en", "source": {"video_title": "Mizkif Stream", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_016", "text": "Stream snipers, bugs, technical issues — the show must go on.", "tags": ["funny", "honest", "relatable", "dedication"], "language": "en", "source": {"video_title": "Mizkif Stream Moments", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_017", "text": "I want to make something that outlasts me. That is the real goal.", "tags": ["deep", "legacy", "honest", "motivational"], "language": "en", "source": {"video_title": "Mizkif Interview", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_018", "text": "Parasocial is weird but I genuinely love my chat. Not in a weird way. In an actually weird way.", "tags": ["funny", "honest", "community", "iconic"], "language": "en", "source": {"video_title": "Mizkif Stream", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_019", "text": "You do not need connections. You need consistency and a camera.", "tags": ["motivational", "honest", "life-advice", "deep"], "language": "en", "source": {"video_title": "Mizkif Creator Advice", "youtube_url": "https://www.youtube.com/@Mizkif"}},
    {"id": "miz_020", "text": "Good night chat. You are my favourite people on the planet. Do not tell anyone.", "tags": ["heartfelt", "funny", "outro", "community"], "language": "en", "source": {"video_title": "Mizkif Stream Outro", "youtube_url": "https://www.youtube.com/@Mizkif"}}
  ]
}
