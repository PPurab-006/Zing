    {"id": "speed_013", "text": "My mom supported me when nobody watched. She's the real MVP.", "tags": ["heartfelt", "emotional", "family", "honest"], "language": "en", "source": {"video_title": "IShowSpeed Stream", "youtube_url": "https://www.youtube.com/@IShowSpeed"}},
